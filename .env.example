# Copie a .env (ignorado por git) si su flujo local o Runme lo necesita.
# Nunca ponga valores reales de credenciales en este archivo ni en .env.

# Raíz del proyecto clusterlog, si no se ejecuta desde ahí.
CLUSTERLOG_ROOT=.

# Ruta a SU llave pública (o base) para identidad/firma. Nunca la ruta de la
# llave privada de otra persona, y nunca el contenido de una llave privada.
CLUSTERLOG_SSH_KEY=

# Entorno lógico para runbooks que necesiten distinguir local/staging/prod.
# Valores esperados: local, ci, staging, production.
CLUSTERLOG_ENV=local

# Ruta a un archivo JSON de memoria ya redactado (sin secretos), usado por
# el flujo de ejemplo de "memory create --from-json" en AGENTS.md.
CLUSTERLOG_MEMORY_JSON=
